# Required. The server mints short-lived, session-scoped JWTs from this.
# The browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Optional. Passed to the Vidu provider as apiUrl when you need a
# non-default coordinator. Leave unset for production Reactor.
# NEXT_PUBLIC_COORDINATOR_URL=
